# Binance 母账户只读 API。只需要母账户，不需要给每个子账户单独配置 API。
# 安全建议：只开启读取权限，关闭交易/提现权限，并在 Binance 后台绑定服务器出口 IP。
BINANCE_API_KEY=your_master_account_readonly_api_key
BINANCE_API_SECRET=your_master_account_readonly_api_secret

# Web 服务端口。本机访问示例：http://localhost:5173
PORT=5173

# Binance API 地址。绝大多数用户保持默认即可。
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BINANCE_DAPI_BASE_URL=https://dapi.binance.com
BINANCE_PAPI_BASE_URL=https://api.binance.com

# Binance 签名请求配置。网络较慢时可适当调大 RECV_WINDOW。
BINANCE_RECV_WINDOW=5000
BINANCE_SIGNED_REQUEST_RETRIES=2

# 页面数据缓存时间，单位毫秒。默认 15 秒，避免频繁刷新时打爆 API。
CACHE_TTL_MS=15000

# 交易额统计缓存时间，单位毫秒。默认 5 分钟。
TRADING_STATS_CACHE_TTL_MS=300000

# 自动净值采样间隔，单位毫秒。默认 5 分钟记录一次资金快照。
SNAPSHOT_INTERVAL_MS=300000

# 首次启动或断点恢复时，向前回看多少天的入金/出金/划转流水。
TRANSFER_LOOKBACK_DAYS=14

# 本地历史数据保留天数。0 表示永久保留，适合长期记录收益曲线。
DATA_RETENTION_DAYS=0

# 手动标记统一账户。多个子账户 email 用英文逗号分隔；留空则按命名规则自动判断。
UNIFIED_SUB_ACCOUNT_EMAILS=

# 快照异常保护：如果总净值相对上一条快照变化过大，会拒绝这条快照。
# 真实链上入金/出金会先被识别为现金流，再参与这个保护判断。
SNAPSHOT_MIN_TOTAL_RATIO=0.7
SNAPSHOT_MAX_TOTAL_RATIO=1.3

# 可选：旺财 AI 短评和气泡。接口需要兼容 OpenAI /chat/completions。
# 留空时仍可完整运行，只是使用本地预设文案。
WANGCAI_LLM_BASE_URL=
WANGCAI_LLM_API_KEY=
WANGCAI_LLM_MODEL=gpt-5.5
